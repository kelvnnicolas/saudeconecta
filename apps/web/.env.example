# URL da API FastAPI (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (mesmo projeto usado pelo backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (frontend) — opcional em dev
NEXT_PUBLIC_SENTRY_DSN=

# Login social além do Google: os botões ficam escondidos até o provedor estar ativo no Supabase.
# LinkedIn: crie o app no LinkedIn Developers e ative "LinkedIn (OIDC)" no Supabase antes de ligar.
NEXT_PUBLIC_LINKEDIN_LOGIN=false
NEXT_PUBLIC_FACEBOOK_LOGIN=false
