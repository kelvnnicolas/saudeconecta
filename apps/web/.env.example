# URL da API FastAPI (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (mesmo projeto usado pelo backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (frontend) — opcional em dev
NEXT_PUBLIC_SENTRY_DSN=

# Login com Facebook: escondido porque o provedor está desativado no Supabase. Ative o provedor e
# defina "true" para trazer o botão de volta. (O LinkedIn não precisa de variável: o botão consulta o
# Supabase e passa a funcionar quando o provedor "LinkedIn (OIDC)" for ativado.)
NEXT_PUBLIC_FACEBOOK_LOGIN=false
