# URL da API FastAPI (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (mesmo projeto usado pelo backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (frontend) — opcional em dev
NEXT_PUBLIC_SENTRY_DSN=

# Login social: "true" troca o botão do Facebook pelo do LinkedIn. Só ligue depois de criar o app no
# LinkedIn Developers e ativar o provider "LinkedIn (OIDC)" no Supabase.
NEXT_PUBLIC_LINKEDIN_LOGIN=false
